enum Channel {
  WHATSAPP
  EMAIL
}

enum NotificationStatus {
  QUEUED
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

enum FindingKind {
  NEVER_INVOICED
  EXPIRED_DISCOUNT_APPLIED
  WRONG_TAX
  EXPIRED_BUT_ACTIVE
  STUCK_DRAFT
  UNSENT_INVOICE
}

enum RiskBand {
  LOW
  MEDIUM
  HIGH
}

model NotificationLog {
  id                String             @id @default(cuid())
  channel           Channel
  template          String             @db.VarChar(100)
  toAddress         String
  customerId        String?
  entity            String?            @db.VarChar(100)
  entityId          String?            @db.VarChar(100)
  payload           Json
  status            NotificationStatus @default(QUEUED)
  providerMessageId String?            @db.VarChar(191)
  error             String?            @db.Text
  attempts          Int                @default(0)
  createdAt         DateTime           @default(now())
  sentAt            DateTime?

  @@index([customerId, createdAt])
  @@index([status])
  @@index([entity, entityId])
  @@index([entity, entityId, createdAt])
  @@unique([template, entity, entityId, channel])
}

model MessageTemplate {
  id        String   @id @default(cuid())
  key       String   @unique @db.VarChar(100)
  channel   Channel
  subject   String?
  body      String   @db.Text
  isActive  Boolean  @default(true)
  updatedAt DateTime @updatedAt
}

model WhatsAppSession {
  id         String    @id @default(cuid())
  phone      String    @unique @db.VarChar(50)
  customerId String?
  verifiedAt DateTime?
  lastIntent String?
  context    Json?
  updatedAt  DateTime  @updatedAt
}

model LeakageFinding {
  id           String      @id @default(cuid())
  kind         FindingKind
  entity       String      @db.VarChar(100)
  entityId     String      @db.VarChar(100)
  amountAtRisk Decimal     @db.Decimal(14, 2)
  detail       Json
  resolvedAt   DateTime?
  detectedAt   DateTime    @default(now())

  @@unique([kind, entity, entityId])
}

model RiskScore {
  id         String   @id @default(cuid())
  customerId String   @unique
  score      Int
  band       RiskBand
  drivers    Json
  computedAt DateTime @default(now())
}

model ForecastSnapshot {
  id                  String   @id @default(cuid())
  month               DateTime
  expectedRevenue     Decimal  @db.Decimal(14, 2)
  expectedCollections Decimal  @db.Decimal(14, 2)
  assumptions         Json
  createdAt           DateTime @default(now())

  @@unique([month, createdAt])
}

model MrrSnapshot {
  id             String   @id @default(cuid())
  month          DateTime @unique
  mrr            Decimal  @db.Decimal(14, 2)
  newMrr         Decimal  @db.Decimal(14, 2)
  expansionMrr   Decimal  @db.Decimal(14, 2)
  contractionMrr Decimal  @db.Decimal(14, 2)
  churnedMrr     Decimal  @db.Decimal(14, 2)
  activeCount    Int
}

model AiQueryLog {
  id           String   @id @default(cuid())
  userId       String?
  question     String   @db.Text
  generatedSql String?  @db.Text
  success      Boolean  @default(true)
  error        String?  @db.Text
  durationMs   Int?
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}
